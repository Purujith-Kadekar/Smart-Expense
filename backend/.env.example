# Copy to backend/.env for running the Flask app directly on your host.
# docker-compose.yml sets all of these itself, so you do NOT need this file
# for `docker-compose up`.

# --- LocalStack routing -----------------------------------------------------
# Where the BACKEND reaches LocalStack.
#   on your host:      http://localhost:4566
#   inside a container: http://localstack:4566
AWS_ENDPOINT_URL=http://localhost:4566

# Where the BROWSER reaches LocalStack. Used only to sign presigned upload
# URLs. A SigV4 signature covers the Host header, so a URL signed for
# "localstack" cannot be sent to "localhost" — hence the separate value.
AWS_PUBLIC_ENDPOINT_URL=http://localhost:4566

# --- Credentials ------------------------------------------------------------
# Dummy values. LocalStack does not validate them, but they must be set or
# boto3 falls back to the IMDS chain and stalls ~5s per call.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# --- Resources (must match localstack/init.py) ------------------------------
S3_BUCKET=receipts-bucket
TABLE_NAME=ExpenseRecords
USERS_TABLE_NAME=Users
BUDGETS_TABLE_NAME=Budgets
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:ExpenseAlerts

# --- OCR --------------------------------------------------------------------
# easyocr   — more accurate, needs torch + ~100MB of model weights
# tesseract — lighter, needs the tesseract-ocr system binary
OCR_ENGINE=tesseract

# --- App --------------------------------------------------------------------
BUDGET_LIMIT=20000
PORT=5000

# Auto-reload + better error pages. Never enable on a reachable host: the
# Flask debugger allows remote code execution.
FLASK_DEBUG=1

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRY_HOURS=24

# Comma-separated frontend origins. localhost on any port is always allowed.
ALLOWED_ORIGINS=http://localhost:5173

# SES sender. LocalStack accepts any address.
SES_VERIFIED_SENDER=noreply@outlay.local

# MOCK_AWS=1 swaps every AWS call for an in-memory stub so the app runs with
# no LocalStack at all. Leave it UNSET to talk to LocalStack.
# MOCK_AWS=1

# --- Durable storage ---------------------------------------------------------
# By default `python app.py` with no AWS credentials uses IN-MEMORY storage:
# every account, budget and receipt is lost when the process exits, which
# looks exactly like "nothing is storing". Two ways to fix that:
#
# Option A — file-backed dev storage (no Docker, no AWS account, durable):
#   MOCK_AWS=1
#   MOCK_PERSIST_FILE=./outlay-dev-state.json
# (writes snapshot to that JSON file after every change; reloads on start)
#
# Option B — real Amazon DynamoDB (durable, AWS free tier covers 25 GB):
#   1) run `aws configure` with real credentials
#   2) python localstack/init.py --aws     # creates tables + bucket + CORS
#   3) comment out BOTH AWS_ENDPOINT_URL and AWS_PUBLIC_ENDPOINT_URL above
#      (unset endpoint = boto3 talks to real AWS)
#   4) set MOCK_AWS=0
# Verify either setup at http://localhost:5000/api/system/storage — it shows
# the active mode and whether each table is reachable.
